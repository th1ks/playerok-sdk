// Project-local Zed settings — подстроены под конфиги этого шаблона.
// Требуется расширение "Biome" (Zed сам предложит установить его при открытии
// проекта). TypeScript берётся из node_modules проекта автоматически.
{
  // Форматирование при каждом сохранении.
  "format_on_save": "on",
  "formatter": "language_server",

  // Табы = 2 пробела, как в biome.json / .editorconfig.
  "tab_size": 2,
  "hard_tabs": false,
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,

  // Biome как форматтер + автофикс и сортировка импортов при сохранении —
  // для всех языков, которыми он управляет в этом проекте.
  "languages": {
    "TypeScript": {
      "formatter": {
        "language_server": { "name": "biome" }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TSX": {
      "formatter": {
        "language_server": { "name": "biome" }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JavaScript": {
      "formatter": {
        "language_server": { "name": "biome" }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JSON": {
      "formatter": {
        "language_server": { "name": "biome" }
      }
    },
    "JSONC": {
      "formatter": {
        "language_server": { "name": "biome" }
      }
    }
  },

  "lsp": {
    // Biome LSP: подхватывать biome.json из корня проекта.
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },

    // TypeScript-сервер: как оформлять авто-импорты.
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            // Импортировать по имени пакета / alias (@/...), а не относительным
            // путём и не глубоким путём внутрь node_modules.
            "importModuleSpecifier": "non-relative",
            // Прятать из подсказок глубокие внутренние пути пакетов
            // (dist/src/lib/esm/cjs/...) и node:-билтины — оставлять чистый вход.
            "autoImportSpecifierExcludeRegexes": [
              "^node:",
              "/(dist|src|lib|esm|cjs|types|internal)/"
            ]
          }
        },
        "javascript": {
          "preferences": {
            "importModuleSpecifier": "non-relative",
            "autoImportSpecifierExcludeRegexes": [
              "^node:",
              "/(dist|src|lib|esm|cjs|types|internal)/"
            ]
          }
        }
      }
    }
  }
}
